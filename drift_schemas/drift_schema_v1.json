  "fixed_sql": [
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL UNIQUE, \"icon\" INTEGER NOT NULL, \"is_income\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_income\" IN (0, 1)), \"sort_order\" INTEGER NOT NULL, \"archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"archived\" IN (0, 1)));"
        }
      ]
    },
    {
      "name": "transactions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"transactions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"amount_kurus\" INTEGER NOT NULL CHECK(\"amount_kurus\" > 0), \"is_income\" INTEGER NOT NULL CHECK (\"is_income\" IN (0, 1)), \"category_id\" INTEGER NOT NULL REFERENCES categories (id), \"note\" TEXT NOT NULL DEFAULT '', \"note_norm\" TEXT NOT NULL DEFAULT '', \"day\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "budgets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"budgets\" (\"category_id\" INTEGER NOT NULL REFERENCES categories (id), \"monthly_limit_kurus\" INTEGER NOT NULL, PRIMARY KEY (\"category_id\"));"
        }
      ]
    },
    {
      "name": "keyword_hits",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"keyword_hits\" (\"keyword\" TEXT NOT NULL, \"category_id\" INTEGER NOT NULL REFERENCES categories (id), \"hits\" INTEGER NOT NULL DEFAULT 1, PRIMARY KEY (\"keyword\", \"category_id\"));"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "transactions_day",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX transactions_day ON transactions (day)"
        }
      ]
    },
    {
      "name": "transactions_category_day",
